{
  "name": "@shimpeiws/gatefold",
  "version": "0.1.0",
  "description": "Evidence-backed judgement for coding-agent harnesses",
  "type": "module",
  "bin": { "gatefold": "./bin/gatefold.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "ci:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test --run && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
