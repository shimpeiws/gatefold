{
  "name": "@shimpeiws/gatefold",
  "version": "0.5.0",
  "description": "Evidence-backed judgement for coding-agent harnesses",
  "license": "MIT",
  "author": "Shimpei Takamatsu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimpeiws/gatefold.git"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "bin": {
    "gatefold": "./bin/gatefold.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "ci:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test --run && pnpm build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
