{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shimpeiws/gatefold/main/schema/claim-result.v3.json",
  "title": "Gatefold comparison result",
  "description": "Machine-readable claim collection emitted by gatefold compare --format json. Version 3 describes a three-document A -> B comparison: every evidence reference names which input document its pointer resolves against, and per-document metadata moves to the inputs map.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "inputs", "claims"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 3,
      "description": "Version of this result schema. Additive changes keep the version; structural changes bump it."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "Identifies this result as a three-document comparison. No single pflVersion is recorded here because the inputs may carry different versions; see inputs.",
      "properties": {
        "command": {
          "type": "string",
          "const": "compare"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "diff"],
      "description": "Descriptors of the three validated input documents, keyed by their role in the comparison.",
      "properties": {
        "before": { "$ref": "#/$defs/exportInput" },
        "after": { "$ref": "#/$defs/exportInput" },
        "diff": { "$ref": "#/$defs/diffInput" }
      }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "exportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "command",
        "pflVersion",
        "observedSnapshotId",
        "resolvedSnapshotId"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "The input argument as supplied, or '<stdin>'."
        },
        "command": { "type": "string", "const": "export" },
        "pflVersion": { "type": "string", "minLength": 1 },
        "observedSnapshotId": { "type": "string", "minLength": 1 },
        "resolvedSnapshotId": { "type": "string", "minLength": 1 },
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"],
          "description": "The document's envelope completeness."
        },
        "runtimeVersion": {
          "type": ["string", "null"],
          "description": "data.runtime.version of the export, when recorded; null is preserved as null."
        },
        "semanticsVersion": {
          "type": "string",
          "description": "data.resolution.semanticsVersion of the export."
        },
        "classifierVersion": {
          "type": "string",
          "description": "data.interpretation.classifier.version of the export."
        },
        "interpretationOrigin": {
          "type": "string",
          "enum": ["stored", "recomputed"],
          "description": "data.interpretation.origin of the export."
        }
      }
    },
    "diffInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "command",
        "pflVersion",
        "observedSnapshotIdA",
        "observedSnapshotIdB",
        "resolvedSnapshotIdA",
        "resolvedSnapshotIdB"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "The input argument as supplied, or '<stdin>'."
        },
        "command": { "type": "string", "const": "diff" },
        "pflVersion": { "type": "string", "minLength": 1 },
        "observedSnapshotIdA": { "type": "string", "minLength": 1 },
        "observedSnapshotIdB": { "type": "string", "minLength": 1 },
        "resolvedSnapshotIdA": { "type": "string", "minLength": 1 },
        "resolvedSnapshotIdB": { "type": "string", "minLength": 1 },
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"],
          "description": "The document's envelope completeness."
        },
        "classifierVersionA": {
          "type": "string",
          "description": "data.interpretation.a.classifierVersion of the diff."
        },
        "classifierVersionB": {
          "type": "string",
          "description": "data.interpretation.b.classifierVersion of the diff."
        },
        "interpretationOriginA": {
          "type": "string",
          "enum": ["stored", "recomputed"],
          "description": "data.interpretation.a.origin of the diff."
        },
        "interpretationOriginB": {
          "type": "string",
          "enum": ["stored", "recomputed"],
          "description": "data.interpretation.b.origin of the diff."
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "ruleId", "evidence", "provenance", "confidence"],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "description": "A single descriptive statement about the comparison. Never a judgement of quality."
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier of the rule that produced this claim. Required in v3; all v3 results are produced by this release or later."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceReference" },
          "description": "References into the three input documents that support the claim. A claim without evidence is invalid."
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Certainty that the evidence supports the claim. 1 = fully supported. Not a harness quality score."
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pointer"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["before", "after", "diff"],
          "description": "Which of the three input documents the pointer resolves against."
        },
        "pointer": {
          "type": "string",
          "pattern": "^$|^(?:/(?:[^/~]|~0|~1)*)*$",
          "description": "JSON Pointer (RFC 6901) into the document named by source. The empty string references the whole document."
        },
        "elementId": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the referenced element, verbatim from the input document."
        },
        "note": {
          "type": "string",
          "description": "Optional human-readable clarification of what the reference shows."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transform"],
      "description": "Per-document metadata (file labels, versions, snapshot ids) lives in the top-level inputs map because a comparison claim can cite up to three documents.",
      "properties": {
        "transform": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names of the transformations applied between the raw inputs and this claim, in application order. Empty when the claim reads the inputs directly."
        }
      }
    }
  }
}
